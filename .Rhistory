# Create a simple numeric vector
my_numbers <- c(10, 20, 30, 40, 50)
# Calculate mean
mean_value <- mean(my_numbers)
print(paste("Mean value is:", mean_value))
# Create a simple plot
hist(my_numbers, main = "Histogram of My Numbers", col = "skyblue", border = "white")
